<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CrossfitWellnessApp.Models"
             x:Class="CrossfitWellnessApp.EjerciciosPage"
             BackgroundColor="#0A0A0A"
             Shell.NavBarIsVisible="False"
             Title="Catálogo de Ejercicios">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABECERA -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="22,40,22,16"
                             Spacing="4">
            <Label Text="⚡ FORGE"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#9FE870"
                   CharacterSpacing="1" />
            <Label Text="Catálogo de Ejercicios"
                   FontSize="14"
                   TextColor="#8A8A8A"
                   CharacterSpacing="2" />
        </VerticalStackLayout>

        <!-- LISTA DE EJERCICIOS -->
        <CollectionView Grid.Row="1"
                        x:Name="CvEjercicios"
                        Margin="22,0,22,0"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Ejercicio">
                    <Border BackgroundColor="#141414"
                            Stroke="#1F1F1F"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEjercicioTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="14">

                            <!-- MINIATURA -->
                            <Border Grid.Column="0"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    BackgroundColor="#0F0F0F"
                                    Stroke="#2A2A2A"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Image Source="{Binding UrlMultimedia}"
                                       Aspect="AspectFill"
                                       HeightRequest="80"
                                       WidthRequest="80" />
                            </Border>

                            <!-- DATOS -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Nombre}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label Text="{Binding GrupoMuscular}"
                                       FontSize="12"
                                       TextColor="#9FE870"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="26"
                                   TextColor="#9FE870"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- BOTÓN VOLVER -->
        <Button Grid.Row="2"
                Text="← VOLVER AL PANEL"
                Clicked="OnVolverClicked"
                BackgroundColor="#9FE870"
                TextColor="#0A0A0A"
                FontAttributes="Bold"
                FontSize="15"
                HeightRequest="54"
                CornerRadius="16"
                Margin="22,14,22,30" />

    </Grid>
</ContentPage>