<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CrossfitWellnessApp.Models"
             x:Class="CrossfitWellnessApp.BienestarPage"
             BackgroundColor="#0A0A0A"
             Shell.NavBarIsVisible="False"
             Title="Consejos de Bienestar">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- CABECERA -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="22,40,22,16"
                             Spacing="4">
            <Label Text="⚡ FORGE"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#9FE870"
                   CharacterSpacing="1" />
            <Label Text="Consejos de Bienestar"
                   FontSize="14"
                   TextColor="#8A8A8A"
                   CharacterSpacing="2" />
        </VerticalStackLayout>

        <!-- FILTROS POR CATEGORÍA -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="22,0,22,12">
            <HorizontalStackLayout Spacing="10">

                <Button x:Name="BtnTodos"
                        Text="Todos"
                        Clicked="OnFiltroTodosClicked"
                        BackgroundColor="#9FE870"
                        TextColor="#0A0A0A"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="40"
                        Padding="16,0"
                        CornerRadius="20" />

                <Button x:Name="BtnSalud"
                        Text="🏥 Salud"
                        Clicked="OnFiltroSaludClicked"
                        BackgroundColor="#141414"
                        TextColor="#9FE870"
                        BorderColor="#9FE870"
                        BorderWidth="1"
                        FontSize="13"
                        HeightRequest="40"
                        Padding="16,0"
                        CornerRadius="20" />

                <Button x:Name="BtnEntrenamiento"
                        Text="🏋️ Entrenamiento"
                        Clicked="OnFiltroEntrenamientoClicked"
                        BackgroundColor="#141414"
                        TextColor="#9FE870"
                        BorderColor="#9FE870"
                        BorderWidth="1"
                        FontSize="13"
                        HeightRequest="40"
                        Padding="16,0"
                        CornerRadius="20" />

                <Button x:Name="BtnNutricion"
                        Text="🥗 Nutrición"
                        Clicked="OnFiltroNutricionClicked"
                        BackgroundColor="#141414"
                        TextColor="#9FE870"
                        BorderColor="#9FE870"
                        BorderWidth="1"
                        FontSize="13"
                        HeightRequest="40"
                        Padding="16,0"
                        CornerRadius="20" />

            </HorizontalStackLayout>
        </ScrollView>

        <!-- LISTA DE CONSEJOS -->
        <CollectionView Grid.Row="2"
                        x:Name="CvConsejos"
                        Margin="22,0,22,0"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConsejoBienestar">
                    <Border BackgroundColor="#141414"
                            Stroke="#1F1F1F"
                            StrokeThickness="1"
                            Padding="18"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConsejoTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <!-- CATEGORÍA -->
                            <Border BackgroundColor="#0F0F0F"
                                    Stroke="#9FE870"
                                    StrokeThickness="1"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Categoria}"
                                       FontSize="11"
                                       TextColor="#9FE870"
                                       FontAttributes="Bold" />
                            </Border>

                            <!-- TÍTULO -->
                            <Label Text="{Binding Titulo}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   LineBreakMode="WordWrap" />

                            <!-- PREVIEW DEL CONTENIDO -->
                            <Label Text="{Binding Contenido}"
                                   FontSize="13"
                                   TextColor="#A8A8A8"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3" />

                            <!-- CTA -->
                            <Label Text="Leer completo →"
                                   FontSize="12"
                                   TextColor="#9FE870"
                                   HorizontalOptions="End"
                                   Margin="0,4,0,0" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- BOTÓN VOLVER -->
        <Button Grid.Row="3"
                Text="← VOLVER AL PANEL"
                Clicked="OnVolverClicked"
                BackgroundColor="#9FE870"
                TextColor="#0A0A0A"
                FontAttributes="Bold"
                FontSize="15"
                HeightRequest="54"
                CornerRadius="16"
                Margin="22,14,22,30" />

    </Grid>
</ContentPage>